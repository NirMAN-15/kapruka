# Gemini API Key (preferred). Supports a single key or a comma-separated list of keys for automatic failover rotation.
GEMINI_API_KEY=your_gemini_api_key_here,another_key_here

# Anthropic API Key (alternative)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Kapruka MCP Server URL
KAPRUKA_MCP_URL=https://mcp.kapruka.com/mcp

# Server port
PORT=5000
